# ---- Spark Lab settings (edit, then: docker compose up -d) ----
LAB_PORT=8100
LAB_USER=spark
# plaintext kept here only for the owner's reference; Caddy uses the bcrypt hash
LAB_PASSWORD=change-me
LAB_PASSWORD_HASH='generated-by-bootstrap.sh'

# resource caps (2 workers). DGX Spark CPU+GPU share 128GB unified memory
WORKER_CORES=8
WORKER_MEMORY=10g
WORKER_MEM_LIMIT=12g
DRIVER_MEMORY=4g
